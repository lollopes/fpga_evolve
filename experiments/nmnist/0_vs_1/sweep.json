{
    "project": "eio-neat-nmnist-0vs1",
    "method": "bayes",
    "metric": {"name": "val_acc", "goal": "maximize"},
    "generations": 100,
    "count": 50,
    "early_terminate": {
        "type": "hyperband",
        "min_iter": 25,
        "eta": 2
    },
    "parameters": {
        "k": {"values": [2, 3, 4]},
        "lut_bit_rate": {"distribution": "log_uniform_values", "min": 0.01, "max": 0.15},
        "p_add_node": {"distribution": "uniform", "min": 0.05, "max": 0.50},
        "p_add_connection": {"distribution": "uniform", "min": 0.10, "max": 0.50},
        "p_crossover": {"distribution": "uniform", "min": 0.20, "max": 0.75},
        "compatibility_threshold": {"distribution": "log_uniform_values", "min": 0.3, "max": 3.0},
        "tournament_k": {"values": [2, 3, 5, 8]},
        "initial_connections_per_output": {"values": [10, 20, 35, 50]}
    }
}
